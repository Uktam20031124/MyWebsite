# Nusxa oling: cp .env.example .env  — va qiymatlarni o'zgartiring.

# Production'da 0 qiling
DJANGO_DEBUG=1

# Production uchun majburiy. Yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# HTTPS domen bo'lsa: https://crm.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ixtiyoriy
# DJANGO_DB_PATH=/var/lib/darsxona/db.sqlite3
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_LOG_LEVEL=INFO

# Login himoyasi: N ta xato urinishdan keyin IP shuncha soniya bloklanadi
# DJANGO_LOGIN_FAILURE_LIMIT=5
# DJANGO_LOGIN_LOCKOUT_SECONDS=900
# gunicorn bir nechta worker bilan: urinishlar hisobi umumiy bo'lishi uchun
# DJANGO_CACHE_DIR=/var/tmp/darsxona-cache
# Faqat nginx ortida (aks holda IP'ni soxtalashtirish mumkin)
# DJANGO_TRUST_X_FORWARDED_FOR=1

# `manage.py bootstrap` uchun boshlang'ich parol
# DARSXONA_PASSWORD=

# Test havolalarini Telegram orqali yuborish (faqat TELEGRAM_SENDER_ID akkauntidan).
# my.telegram.org → API development tools; keyin: python manage.py telegram_login
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SENDER_ID=7730996406
# TELEGRAM_SESSION_FILE=/var/lib/darsxona/telegram_session

# Baza zaxirasi (manage.py backup_db). Repozitoriydan tashqarida saqlang.
# DARSXONA_BACKUP_DIR=/home/ubuntu/darsxona-backups
# DARSXONA_BACKUP_KEEP_DAYS=14

# Saytning ochiq manzili (eslatmalardagi havolalar uchun)
# DARSXONA_SITE_URL=https://crm.example.uz
# DARSXONA_REMINDER_AFTER_HOURS=3
